# --- Aplicación ---
LOG_LEVEL=INFO
# Orígenes permitidos para CORS en formato JSON, ej: ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- MySQL (usado por el contenedor de MySQL y por la API) ---
MYSQL_ROOT_PASSWORD=cambia-esta-password-root
MYSQL_DATABASE=api_test
MYSQL_USER=api_user
MYSQL_PASSWORD=cambia-esta-password
MYSQL_HOST=db
MYSQL_PORT=3306
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Sesiones con cookie ---
SESSION_HOURS=8
# En producción siempre true (requiere HTTPS). localhost se considera seguro en los navegadores.
COOKIE_SECURE=true

# --- API keys ---
API_KEY_DAYS=90

# --- Bloqueo de cuenta ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Cambia-Esta-Password1
ADMIN_NOMBRE=Administrador
